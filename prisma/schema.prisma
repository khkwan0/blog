// blog.kkith.com/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id @default(cuid())
  username            String      @unique
  name                String
  email               String?     @unique
  emailVerified       Boolean     @default(false)
  phoneNumber         String?     @unique
  phoneNumberVerified Boolean     @default(false)
  image                 String?
  profileSetupComplete  Boolean     @default(true)
  mentionColor  String?
  hashtagColor  String?
  role          Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  blogEntries   BlogEntry[]
  blogEntryLikes BlogEntryLike[]
  comments      Comment[]
  commentLikes  CommentLike[]
  sessions      Session[]
  accounts      Account[]
  following     SocialGraph[] @relation("UserFollowing")
  followers     SocialGraph[] @relation("UserFollowers")
  mentions      BlogEntryMention[]
}

model SocialGraph {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("SocialGraph")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

enum BlogEntryFormat {
  TEXT
  VIDEO
  AUDIO
  HTML
  MARKDOWN
}

enum BlogEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogEntry {
  id          String           @id @default(cuid())
  title       String?
  slug        String           @unique
  excerpt     String?
  status      BlogEntryStatus  @default(DRAFT)
  publishedAt DateTime?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  blocks      BlogEntryBlock[]
  hashTags    HashTag[]
  mentions    BlogEntryMention[]
  likes          BlogEntryLike[]
  comments       Comment[]
  totalLikes     Int              @default(1)
  totalReposts   Int              @default(0)
  repostedFromId String?
  repostedFrom   BlogEntry?       @relation("BlogEntryReposts", fields: [repostedFromId], references: [id], onDelete: Cascade)
  reposts        BlogEntry[]      @relation("BlogEntryReposts")
  createdAt      DateTime         @default(now())
  modifiedAt     DateTime         @default(now()) @updatedAt

  @@unique([ownerId, repostedFromId])
  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
  @@index([repostedFromId])
}

model BlogEntryBlock {
  id          String          @id @default(cuid())
  blogEntryId String
  blogEntry   BlogEntry       @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  format      BlogEntryFormat
  content     String
  sortOrder   Int

  @@unique([blogEntryId, sortOrder])
  @@index([blogEntryId])
}

model HashTag {
  id          String    @id @default(cuid())
  blogEntryId String
  hashtag     String
  display     String
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)

  @@unique([blogEntryId, hashtag])
  @@index([hashtag])
  @@map("HashTags")
}

model BlogEntryMention {
  id          String    @id @default(cuid())
  blogEntryId String
  username    String
  display     String
  userId      String?
  createdAt   DateTime  @default(now())
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([blogEntryId, username])
  @@index([blogEntryId])
  @@index([username])
  @@index([userId])
  @@map("BlogEntryMentions")
}

model BlogEntryLike {
  id          String    @id @default(cuid())
  blogEntryId String
  userId      String
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([blogEntryId, userId])
  @@index([userId])
}

model Comment {
  id          String        @id @default(cuid())
  blogEntryId String
  userId      String
  parentId    String?
  content     String
  totalLikes  Int           @default(1)
  createdAt   DateTime      @default(now())
  blogEntry   BlogEntry     @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  likes       CommentLike[]

  @@index([blogEntryId, parentId, createdAt])
  @@index([parentId])
  @@map("Comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}
