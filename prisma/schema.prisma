// blog.kkith.com/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id @default(cuid())
  name                String      @unique @map("username")
  email               String?     @unique
  emailVerified       Boolean     @default(false)
  phoneNumber         String?     @unique
  phoneNumberVerified Boolean     @default(false)
  image         String?
  role          Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  blogEntries   BlogEntry[]
  blogEntryLikes BlogEntryLike[]
  blogEntryReplies BlogEntryReply[]
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

enum BlogEntryFormat {
  TEXT
  VIDEO
  AUDIO
  HTML
  MARKDOWN
}

enum BlogEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogEntry {
  id          String           @id @default(cuid())
  title       String?
  slug        String           @unique
  excerpt     String?
  status      BlogEntryStatus  @default(DRAFT)
  publishedAt DateTime?
  ownerId     String
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  blocks      BlogEntryBlock[]
  hashTags    HashTag[]
  likes       BlogEntryLike[]
  replies     BlogEntryReply[]
  totalLikes  Int              @default(1)
  createdAt   DateTime         @default(now())
  modifiedAt  DateTime         @default(now()) @updatedAt

  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
}

model BlogEntryBlock {
  id          String          @id @default(cuid())
  blogEntryId String
  blogEntry   BlogEntry       @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  format      BlogEntryFormat
  content     String
  sortOrder   Int

  @@unique([blogEntryId, sortOrder])
  @@index([blogEntryId])
}

model HashTag {
  id          String    @id @default(cuid())
  blogEntryId String
  hashtag     String
  display     String
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)

  @@unique([blogEntryId, hashtag])
  @@index([hashtag])
  @@map("HashTags")
}

model BlogEntryLike {
  id          String    @id @default(cuid())
  blogEntryId String
  userId      String
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([blogEntryId, userId])
  @@index([userId])
}

model BlogEntryReply {
  id          String    @id @default(cuid())
  blogEntryId String
  userId      String
  content     String
  createdAt   DateTime  @default(now())
  blogEntry   BlogEntry @relation(fields: [blogEntryId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogEntryId, createdAt])
}
